let len: [JsValue] -> Nat = std::array::len
let push: [JsValue] -> JsValue -> [JsValue] = std::array::push
let prepend: [JsValue] -> JsValue -> [JsValue] = std::array::prepend
let concat: [JsValue] -> [JsValue] -> [JsValue] = std::array::concat
let get_or: [JsValue] -> Nat -> JsValue -> JsValue = fn arr i fallback => match std::array::get arr i with
  | #Some value => value
  | #None => fallback
end
let set_or: [JsValue] -> Nat -> JsValue -> [JsValue] = fn arr i value => match std::array::set arr i value with
  | #Some updated => updated
  | #None => arr
end
let slice_or: [JsValue] -> Nat -> Nat -> [JsValue] = fn arr from to => match std::array::slice arr from to with
  | #Some part => part
  | #None => []
end
let slice_ok: [JsValue] -> Nat -> Nat -> Boolean = fn arr from to => match std::array::slice arr from to with
  | #Some _ => true
  | #None => false
end
let pop_last: [JsValue] -> JsValue -> JsValue = fn arr fallback => match std::array::pop arr with
  | #Some (last, _) => last
  | #None => fallback
end
let pop_rest: [JsValue] -> [JsValue] = fn arr => match std::array::pop arr with
  | #Some (_, rest) => rest
  | #None => arr
end
let pop_ok: [JsValue] -> Boolean = fn arr => match std::array::pop arr with
  | #Some _ => true
  | #None => false
end
let empty: [JsValue] = []
let count: [JsValue] -> Nat = fn arr => match arr with
  | [] => 0n
  | [_, ..rest] => std::nat::add 1n (count rest)
end
let last_or: [JsValue] -> JsValue -> JsValue = fn arr fallback => match arr with
  | [.., last] => last
  | [] => fallback
end
let ends: [JsValue] -> [JsValue] = fn arr => match arr with
  | [first, .., last] => [first, last]
  | [..] => []
end
let init_of: [JsValue] -> [JsValue] = fn arr => match arr with
  | [..init, _] => init
  | [] => []
end
let middle: [JsValue] -> [JsValue] = fn arr => match arr with
  | [_, ..inner, _] => inner
  | [..] => []
end
let describe = fn arr => match arr with
  | [] => "empty"
  | [0n] => "zero"
  | [0n, 0n, ..] => "zeros"
  | [x] => "one"
  | [_, _, ..] => "many"
end
let wrap: [JsValue] -> [JsValue] = fn arr => [..arr, ..arr]
let around: [JsValue] -> JsValue -> [JsValue] = fn arr x => [x, ..arr, x]
let copy: [JsValue] -> [JsValue] = fn arr => [..arr]
let none: [JsValue] -> [JsValue] = fn arr => [..arr, ..[]]

-- Read every element inside Ruddy so the differential test takes one native
-- snapshot per observation rather than crossing the ABI once per element.
let contents: [JsValue] -> [JsValue] = fn arr => do
 let scan = fn index => match std::array::get arr index with
  | #None => []
  | #Some value => [value, ..scan (std::nat::add index 1n)]
 end
 return scan 0n
end
