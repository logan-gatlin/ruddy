extern mark : fn(Nat) -> Nat = "host.mark"
extern mark_base : fn({ a: Nat, b: Nat }) -> { a: Nat, b: Nat } = "host.markBase"

let base = { a: 1n, b: "b", c: true }
let copy = { ..base }
let extended = { d: 2n, ..base }
let replaced = { a: 5n, ..base }
let retyped = { a: "text", ..base }
let several = { a: 3n, c: false, e: 9n, ..base }
@private let pick = fn v => v
let computed = { d: 4n, ..pick base }
let from_unit = { a: 1n, ..() }
let from_empty = { ..{} }
let pair = (1n, 2n)
let from_pair = { 1: "second", ..pair }
@private let update_a = fn v => { a: 7n, ..v }
let added = update_a { b: 1n }
let overwritten = update_a { a: "old", b: 2n }
let read_back: { a: Nat, b: String, c: Boolean } -> (Nat, String, Boolean) = fn v => (v.a, v.b, v.c)
let read_added: { d: Nat, e: Nat } -> (Nat, Nat) = fn v => (v.d, v.e)
let traced = fn v => { a: mark 10n, c: mark 30n, ..mark_base v }

let set_a: { a: Nat, b: String, c: Boolean } -> { a: Nat, b: String, c: Boolean } = update_a
