{
  "name": "ruddy-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
    "build": "npm run clean && eleventy",
    "dev": "npm run clean && eleventy --serve",
    "test": "node --test lib/*.test.js",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "github-slugger": "^2.0.0",
    "markdown-it": "^15.0.1",
    "markdown-it-anchor": "^10.0.0",
    "tree-sitter-cli": "0.26.12",
    "wrangler": "^4.130.0"
  },
  "allowScripts": {
    "tree-sitter-cli@0.26.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true
  }
}
