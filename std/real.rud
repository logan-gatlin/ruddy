let add: Real -> Real -> Real = fn left => fn right => left + right
let subtract: Real -> Real -> Real = fn left => fn right => left - right
let multiply: Real -> Real -> Real = fn left => fn right => left * right
let divide: Real -> Real -> Real = fn left => fn right => left / right
let negate: Real -> Real = fn value => -value

extern remainder: fn(Real, Real) -> Real = "$prim.real.remainder"
extern abs: fn(Real) -> Real = "$prim.real.abs"
extern sqrt: fn(Real) -> Real = "$prim.real.sqrt"
extern power: fn(Real, Real) -> Real = "$prim.real.power"

@private
extern ordering_equal: fn(Real, Real) -> Bool = "$prim.real.ordering_equal"
@private
extern ordering_less_than: fn(Real, Real) -> Bool = "$prim.real.ordering_less_than"
@private
extern ordering_greater_than: fn(Real, Real) -> Bool = "$prim.real.ordering_greater_than"

extern min: fn(Real, Real) -> Real = "$prim.real.min"
extern max: fn(Real, Real) -> Real = "$prim.real.max"
extern clamp: fn(Real, Real, Real) -> Real = "$prim.real.clamp"
extern floor: fn(Real) -> Int = "$prim.real.floor"
extern ceil: fn(Real) -> Int = "$prim.real.ceil"
extern round: fn(Real) -> Int = "$prim.real.round"
extern truncate: fn(Real) -> Int = "$prim.real.truncate"
extern is_nan: fn(Real) -> Bool = "$prim.real.is_nan"
extern is_finite: fn(Real) -> Bool = "$prim.real.is_finite"
extern is_integer: fn(Real) -> Bool = "$prim.real.is_integer"

extern from_nat: fn(Nat) -> Real = "$prim.real.from_nat"
extern from_int: fn(Int) -> Real = "$prim.real.from_int"

extern sin: fn(Real) -> Real = "$prim.real.sin"
extern cos: fn(Real) -> Real = "$prim.real.cos"
extern tan: fn(Real) -> Real = "$prim.real.tan"
extern asin: fn(Real) -> Real = "$prim.real.asin"
extern acos: fn(Real) -> Real = "$prim.real.acos"
extern atan: fn(Real) -> Real = "$prim.real.atan"
extern atan2: fn(Real, Real) -> Real = "$prim.real.atan2"

extern sinh: fn(Real) -> Real = "$prim.real.sinh"
extern cosh: fn(Real) -> Real = "$prim.real.cosh"
extern tanh: fn(Real) -> Real = "$prim.real.tanh"
extern asinh: fn(Real) -> Real = "$prim.real.asinh"
extern acosh: fn(Real) -> Real = "$prim.real.acosh"
extern atanh: fn(Real) -> Real = "$prim.real.atanh"

extern exp: fn(Real) -> Real = "$prim.real.exp"
extern expm1: fn(Real) -> Real = "$prim.real.expm1"
extern log: fn(Real) -> Real = "$prim.real.log"
extern log1p: fn(Real) -> Real = "$prim.real.log1p"
extern log2: fn(Real) -> Real = "$prim.real.log2"
extern log10: fn(Real) -> Real = "$prim.real.log10"

let e: Real = 2.718281828459045
let ln_2: Real = 0.6931471805599453
let ln_10: Real = 2.302585092994046
let log2_e: Real = 1.4426950408889634
let log10_e: Real = 0.4342944819032518
let pi: Real = 3.141592653589793
let sqrt_1_2: Real = 0.7071067811865476
let sqrt_2: Real = 1.4142135623730951
let tau: Real = 2 * pi

let degrees_to_radians: Real -> Real = fn degrees => degrees * (pi / 180)
let radians_to_degrees: Real -> Real = fn radians => radians * (180 / pi)

@doc "A total ordering for sorting: NaNs compare equal and last, and negative zero precedes positive zero."
let total_compare: order::Ordering Real = fn left right =>
  if ordering_equal left right then #Equal
  else if is_nan left then #Greater
  else if is_nan right then #Less
  else if ordering_less_than left right then #Less
  else if ordering_greater_than left right then #Greater
  else if ordering_less_than (divide 1 left) (divide 1 right) then #Less
  else #Greater
  end

@doc "Numeric comparison: any NaN operand is unordered, and negative and positive zero compare equal."
let compare: order::PartialOrdering Real = fn left right =>
  if is_nan left or is_nan right then #Unordered
  else if ordering_less_than left right then #Less
  else if ordering_greater_than left right then #Greater
  else #Equal
  end

let {
  equal,
  not_equal,
  less_than,
  less_than_or_equal,
  greater_than,
  greater_than_or_equal,
} = order::derive_partial compare
