type Parts = { root: String, dir: String, base: String, ext: String, name: String }
type Error = { message: String }
effect Path = {
  resolve: [String] -> Result String Error,
  relative: { from: String, to: String } -> Result String Error,
}
let resolve = !Path.resolve
let relative = fn from to => !Path.relative { from: from, to: to }
module posix
module windows
@async
extern normalize: String -> String = "$nodePath.native.normalize"
@async
extern basename: String -> String = "$nodePath.native.basename"
@async
extern dirname: String -> String = "$nodePath.native.dirname"
@async
extern extension: String -> String = "$nodePath.native.extname"
@async
extern is_absolute: String -> Bool = "$nodePath.native.isAbsolute"
@async
extern parse: String -> Parts = "$nodePath.native.parse"
@async
extern join: [String] -> String = "$nodePath.native.join"
