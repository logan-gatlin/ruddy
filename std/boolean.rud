@doc "The logical negation."
let logical_not: Bool -> Bool = fn value => not value
@doc "Whether both values are `true`."
let logical_and: Bool -> Bool -> Bool = fn left => fn right => left and right
@doc "Whether either value is `true`."
let logical_or: Bool -> Bool -> Bool = fn left => fn right => left or right
@doc "Whether exactly one value is `true`."
let logical_xor: Bool -> Bool -> Bool = fn left => fn right => left xor right
@doc "Whether a true premise has a true conclusion."
let implies: Bool -> Bool -> Bool = fn premise => fn conclusion =>
  not premise or conclusion

@doc "Orders `false` before `true`."
let compare: order::Ordering Bool = fn left right => match (left, right) with
| (false, true) => #Less
| (true, false) => #Greater
| _ => #Equal
end

@doc "The Boolean comparisons derived from the three-way ordering."
let {
  equal,
  not_equal,
  less_than,
  less_than_or_equal,
  greater_than,
  greater_than_or_equal,
} = order::derive compare
