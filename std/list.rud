let empty: List 'a = #None
let prepend: 'a -> List 'a -> List 'a = fn head tail => #Cons (head, tail)
let singleton: 'a -> List 'a = fn value => #Cons (value, #None)

let head: List 'a -> Option 'a = fn values => match values with
| #Cons (value, _) => #Some value
| #None => #None
end

let tail: List 'a -> Option (List 'a) = fn values => match values with
| #Cons (_, rest) => #Some rest
| #None => #None
end

let is_empty: List 'a -> Boolean = fn values => match values with
| #Cons _ => false
| #None => true
end

let map: ('a -> 'b + ..'effects) -> List 'a -> List 'b + ..'effects =
  fn function values => match values with
  | #Cons (head, tail) => #Cons (function head, map function tail)
  | #None => #None
  end

let fold_left: ('state -> 'a -> 'state + ..'effects) -> 'state -> List 'a -> 'state + ..'effects =
  fn step state values => match values with
  | #Cons (head, tail) => fold_left step (step state head) tail
  | #None => state
  end

let fold_right: ('a -> 'state -> 'state + ..'effects) -> 'state -> List 'a -> 'state + ..'effects =
  fn step state values => match values with
  | #Cons (head, tail) => step head (fold_right step state tail)
  | #None => state
  end

let filter: ('a -> Boolean + ..'effects) -> List 'a -> List 'a + ..'effects =
  fn predicate values => match values with
  | #Cons (head, tail) =>
    if predicate head then #Cons (head, filter predicate tail) else filter predicate tail end
  | #None => #None
  end

let append: List 'a -> List 'a -> List 'a = fn left right => match left with
| #Cons (head, tail) => #Cons (head, append tail right)
| #None => right
end

let reverse_onto: List 'a -> List 'a -> List 'a = fn reversed values => match values with
| #Cons (head, tail) => reverse_onto (#Cons (head, reversed)) tail
| #None => reversed
end

let reverse: List 'a -> List 'a = fn values => reverse_onto (#None) values

let len: List 'a -> Nat = fn values => match values with
| #Cons (_, tail) => nat::add 1n (len tail)
| #None => 0n
end

let any: ('a -> Boolean + ..'effects) -> List 'a -> Boolean + ..'effects =
  fn predicate values => match values with
  | #Cons (head, tail) => predicate head or any predicate tail
  | #None => false
  end

let all: ('a -> Boolean + ..'effects) -> List 'a -> Boolean + ..'effects =
  fn predicate values => match values with
  | #Cons (head, tail) => predicate head and all predicate tail
  | #None => true
  end

let find: ('a -> Boolean + ..'effects) -> List 'a -> Option 'a + ..'effects =
  fn predicate values => match values with
  | #Cons (head, tail) => if predicate head then #Some head else find predicate tail end
  | #None => #None
  end

let contains: ('a -> 'a -> Boolean + ..'effects) -> 'a -> List 'a -> Boolean + ..'effects =
  fn equal needle values => any (fn value => equal needle value) values
