@doc "Creates a mutable cell containing the value."
let new: 'a -> mut 'r 'a + !mut 'r = fn value => mut value

@doc "Reads the current value of a cell."
let get: mut 'r 'a -> 'a + !mut 'r = fn cell => ~cell

@doc "Stores a value in a cell and returns it."
let set: mut 'r 'a -> 'a -> 'a + !mut 'r = fn cell value => cell := value

@doc "Stores a value in a cell and returns the previous value."
let replace = fn cell value => do
  let previous = ~cell
  _ = cell := value
  return previous
end

@doc "Updates a cell with a function and returns the new value."
let update = fn function cell => cell := function (~cell)

@doc "Exchanges the values of two cells."
let swap = fn left right => do
  let left_value = ~left
  let right_value = ~right
  _ = left := right_value
  _ = right := left_value
  return ()
end
