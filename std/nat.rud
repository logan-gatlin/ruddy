@doc "The sum of two `Nat` values."
extern add: fn(Nat, Nat) -> Nat = "$prim.nat.add"
@doc "The first `Nat` value minus the second."
extern subtract: fn(Nat, Nat) -> Nat = "$prim.nat.subtract"
@doc "The product of two `Nat` values."
extern multiply: fn(Nat, Nat) -> Nat = "$prim.nat.multiply"
@doc "The first `Nat` value divided by the second."
extern divide: fn(Nat, Nat) -> Nat = "$prim.nat.divide"
@doc "The remainder after dividing the first `Nat` value by the second."
extern remainder: fn(Nat, Nat) -> Nat = "$prim.nat.remainder"

@private
extern ordering_less_than: fn(Nat, Nat) -> Bool = "$prim.nat.ordering_less_than"
@private
extern ordering_greater_than: fn(Nat, Nat) -> Bool = "$prim.nat.ordering_greater_than"

@doc "The lesser of two `Nat` values."
extern min: fn(Nat, Nat) -> Nat = "$prim.nat.min"
@doc "The greater of two `Nat` values."
extern max: fn(Nat, Nat) -> Nat = "$prim.nat.max"
@doc "The `Nat` value limited to the inclusive lower and upper bounds."
extern clamp: fn(Nat, Nat, Nat) -> Nat = "$prim.nat.clamp"
@doc "Whether the `Nat` value is zero."
let is_zero: Nat -> Bool = fn value => match value with | 0n => true | _ => false end

@doc "Converts an `Int` to `Nat`."
extern from_int: fn(Int) -> Nat = "$prim.nat.from_int"
@doc "Converts a `Real` to `Nat`."
extern from_real: fn(Real) -> Nat = "$prim.nat.from_real"

@doc "The three-way comparison of two `Nat` values."
let compare: order::Ordering Nat = fn left right =>
  if ordering_less_than left right then #Less
  else if ordering_greater_than left right then #Greater
  else #Equal
  end

@doc "The Boolean comparisons derived from the three-way ordering of `Nat` values."
let {
  equal,
  not_equal,
  less_than,
  less_than_or_equal,
  greater_than,
  greater_than_or_equal,
} = order::derive compare

-- Nat8: arithmetic wraps modulo 2^8; division truncates toward zero.
@doc "The least `Nat8` value."
let min_value8: Nat8 = 0n8
@doc "The greatest `Nat8` value."
let max_value8: Nat8 = 255n8
@doc "The sum of two `Nat8` values, wrapping to 8 bits."
extern add8: fn(Nat8, Nat8) -> Nat8 = "$prim.nat.add8"
@doc "The first `Nat8` value minus the second, wrapping to 8 bits."
extern subtract8: fn(Nat8, Nat8) -> Nat8 = "$prim.nat.subtract8"
@doc "The product of two `Nat8` values, wrapping to 8 bits."
extern multiply8: fn(Nat8, Nat8) -> Nat8 = "$prim.nat.multiply8"
@doc "The first `Nat8` value divided by the second."
extern divide8: fn(Nat8, Nat8) -> Nat8 = "$prim.nat.divide8"
@doc "The remainder after dividing the first `Nat8` value by the second."
extern remainder8: fn(Nat8, Nat8) -> Nat8 = "$prim.nat.remainder8"
@private
extern ordering_less_than8: fn(Nat8, Nat8) -> Bool = "$prim.nat.ordering_less_than8"
@private
extern ordering_greater_than8: fn(Nat8, Nat8) -> Bool = "$prim.nat.ordering_greater_than8"
@doc "The lesser of two `Nat8` values."
extern min8: fn(Nat8, Nat8) -> Nat8 = "$prim.nat.min8"
@doc "The greater of two `Nat8` values."
extern max8: fn(Nat8, Nat8) -> Nat8 = "$prim.nat.max8"
@doc "The `Nat8` value limited to the inclusive lower and upper bounds."
extern clamp8: fn(Nat8, Nat8, Nat8) -> Nat8 = "$prim.nat.clamp8"
@doc "Whether the `Nat8` value is zero."
extern is_zero8: fn(Nat8) -> Bool = "$prim.nat.is_zero8"
@doc "Converts a `Nat` to `Nat8`."
extern from_nat8: fn(Nat) -> Nat8 = "$prim.nat.from_nat8"
@doc "Converts an `Int` to `Nat8`."
extern from_int8: fn(Int) -> Nat8 = "$prim.nat.from_int8"
@doc "The decimal text of a `Nat8` value."
extern to_string8: fn(Nat8) -> String = "$prim.nat.to_string8"
@doc "Converts a `Nat8` value to `Nat`."
extern to_nat8: fn(Nat8) -> Nat = "$prim.nat.to_nat8"
@doc "The three-way comparison of two `Nat8` values."
let compare8: order::Ordering Nat8 = fn left right =>
  if ordering_less_than8 left right then #Less
  else if ordering_greater_than8 left right then #Greater
  else #Equal
  end
@doc "The Boolean comparisons derived from the three-way ordering of `Nat8` values."
let {
  equal: equal8,
  not_equal: not_equal8,
  less_than: less_than8,
  less_than_or_equal: less_than_or_equal8,
  greater_than: greater_than8,
  greater_than_or_equal: greater_than_or_equal8,
} = order::derive compare8

