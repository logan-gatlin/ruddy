@async
extern normalize: String -> String = "$nodePath.win32.normalize"
@async
extern basename: String -> String = "$nodePath.win32.basename"
@async
extern dirname: String -> String = "$nodePath.win32.dirname"
@async
extern extension: String -> String = "$nodePath.win32.extname"
@async
extern is_absolute: String -> Bool = "$nodePath.win32.isAbsolute"
@async
extern parse: String -> Parts = "$nodePath.win32.parse"
@async
extern join: [String] -> String = "$nodePath.win32.join"
