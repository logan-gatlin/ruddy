@doc "Noncryptographic random primitives. Local handlers may supply each operation independently."
effect Random = {
  word64: () -> Nat64,
  boolean: () -> Bool,
  real: () -> Real,
}

@doc "Draws a Nat64, including both endpoints of its domain. Performs Random.word64."
let word64 = !Random.word64

@doc "Draws a boolean. Performs Random.boolean; built-in handlers consume one word and use its top bit."
let boolean = !Random.boolean

@doc "Draws a Real in [0, 1). Performs Random.real; built-in handlers consume one word and use its top 53 bits."
let real = !Random.real

@private
extern xor64: fn(Nat64, Nat64) -> Nat64 = "$prim.nat.xor64"

-- SplitMix64, https://prng.di.unimi.it/splitmix64.c (public domain). Advance before mixing,
-- including for seed zero. All arithmetic wraps at 64 bits.
@private
let mix: Nat64 -> Nat64 = fn advanced => do
  let first = nat::multiply64
    (xor64 advanced (nat::divide64 advanced 1073741824n64))
    13787848793156543929n64
  let second = nat::multiply64
    (xor64 first (nat::divide64 first 134217728n64))
    10723151780598845931n64
  return xor64 second (nat::divide64 second 2147483648n64)
end

@private
let real_of_word = fn word => do
  -- Convert 27 and 26 bits separately so even a 32-bit Nat preserves all 53 bits.
  let high = real::from_nat (nat::to_nat64 (nat::divide64 word 137438953472n64))
  let low = real::from_nat
    (nat::to_nat64 (nat::remainder64 (nat::divide64 word 2048n64) 67108864n64))
  return (high * 67108864 + low) / 9007199254740992
end

@private
let with_source:
  (() -> Nat64 + !Random (when 'outer) + ..'effects)
  -> (() -> 'a + !Random + ..'effects)
  -> 'a + !Random (when 'outer) + ..'effects =
  fn source body => do
    let state = mut source ()
    return handle body () with
    | !Random.word64 _ => mix (state := nat::add64 (~state) 11400714819323198485n64)
    | !Random.boolean _ =>
      nat::greater_than_or_equal64
        (mix (state := nat::add64 (~state) 11400714819323198485n64))
        9223372036854775808n64
    | !Random.real _ => real_of_word (mix (state := nat::add64 (~state) 11400714819323198485n64))
    end
  end

@doc "Runs a computation with fresh private SplitMix64 state. All primitive draws share a stream; identical seeds and ordered calls have stable results across backends. Consumes no outer randomness, preserves unrelated effects, and is noncryptographic."
let with_seed = fn seed body => with_source (fn _ => seed) body

@doc "Draws exactly one seed from the nearest outer Random.word64 before running the body with private state. Even empty or aborting bodies consume a seed. Later draws and nested local streams use private state. Assign seeds in stable order before concurrent work; callbacks establish their handler when invoked."
let local = fn body => with_source (fn _ => word64 ()) body

@private
let draw_below: Nat64 -> Nat64 -> Nat64 + !Random = fn bound threshold => do
  let word = word64 ()
  return
    if nat::less_than64 word threshold then draw_below bound threshold
    else nat::remainder64 word bound
    end
end

@doc "Samples below an exclusive Nat64 bound. Zero returns None; one returns Some 0n64; neither draws. Rejection sampling avoids modulo bias for uniform source words, with fewer than two expected draws. A custom source that always supplies rejected words may not terminate."
let nat_below: Nat64 -> Option Nat64 + !Random = fn bound =>
  if nat::is_zero64 bound then #None
  else if nat::equal64 bound 1n64 then #Some 0n64
  else #Some (draw_below bound (nat::remainder64 (nat::subtract64 0n64 bound) bound))
  end

@doc "Chooses an array position without changing the input. Empty arrays return None; singletons return their item; neither draws. Duplicate values retain their positional weight. Uses nat_below and accepts any element type."
let choose: ['a] -> Option 'a + !Random = fn values =>
  match nat_below (nat::from_nat64 (array::len values)) with
  | #None => #None
  | #Some index => array::get values (nat::to_nat64 index)
  end

@private
extern word_bytes: fn(Nat64) -> [Nat8] = "$prim.binary.nat64_to_bytes"

@private
extern signed_bytes: fn([Nat8]) -> Int64 = "$prim.binary.int64_from_bytes"

@private
let signed_word = fn word => signed_bytes (word_bytes word)

@private
let target_bits = do
  let description = reflect::describe (reflect::type_of 0n)
  return match array::get description.nodes description.root with
  | #Some (#Nat { bits, .. }) => bits
  | _ => 32n
  end
end

@private
let power_of_two: Nat -> Nat64 = fn bits =>
  if nat::is_zero bits then 1n64
  else nat::multiply64 2n64 (power_of_two (nat::subtract bits 1n))
  end

@private
let small_word = fn bound => nat::to_nat64 (nat::remainder64 (word64 ()) bound)

@private
let natural = fn _ =>
  if target_bits == 64n then nat::to_nat64 (word64 ())
  else small_word (power_of_two target_bits)
  end

@private
let integer = fn _ =>
  if target_bits == 64n then int::to_int64 (signed_word (word64 ()))
  else if target_bits == 32n then int::to_int32 (int::from_nat32 (small_word 4294967296n64))
  else
    do
      -- The 53-bit signed domain is symmetric, with 2^54 - 1 values. 2^64 mod (2^54 - 1) = 1024.
      -- The offset fits Int64 exactly.
      let offset = signed_word (draw_below 18014398509481983n64 1024n64)
      return int::to_int64 (int::subtract64 offset 9007199254740991i64)
    end
  end

@private
extern character: fn(Nat) -> String = "$prim.json.char_from_code"

@private
let below = fn bound => match nat_below (nat::from_nat64 bound) with
| #Some index => nat::to_nat64 index
| #None => 0n
end

@private
let text: Nat -> String + !Random = fn length =>
  if nat::is_zero length then ""
  else str::concat (character (nat::add 32n (below 95n))) (text (nat::subtract length 1n))
  end

@private
let elements:
  (() -> Bool + !Random + ..'effects) -> Mirror 'a -> Nat -> ['a] + !Random + ..'effects =
  fn spend mirror length =>
    if nat::is_zero length then []
    else [generate_at spend mirror, ..elements spend mirror (nat::subtract length 1n)]
    end

@private
let generate_at:
  (() -> Bool + !Random + ..'effects) -> Mirror 'a -> 'a + !Random + ..'effects =
  fn spend mirror =>
    if not spend () then reflect::construct mirror
    else
      match reflect::shape mirror with
      | #Nat { make, .. } => make (natural ())
      | #Int { make, .. } => make (integer ())
      | #Nat8 { make, .. } => make (nat::from_nat8 (small_word 256n64))
      | #Nat16 { make, .. } => make (nat::from_nat16 (small_word 65536n64))
      | #Nat32 { make, .. } => make (nat::from_nat32 (small_word 4294967296n64))
      | #Nat64 { make, .. } => make (word64 ())
      | #Int8 { make, .. } => make (int::from_nat8 (small_word 256n64))
      | #Int16 { make, .. } => make (int::from_nat16 (small_word 65536n64))
      | #Int32 { make, .. } => make (int::from_nat32 (small_word 4294967296n64))
      | #Int64 { make, .. } => make (signed_word (word64 ()))
      | #Bool { make, .. } => make (boolean ())
      | #Real { make, .. } => make (real ())
      | #String { make, .. } => make (text (below 9n))
      | #EmptyArray { make, .. } => make []
      | #Array view =>
        match view with
        | hide 'element { element, make, .. } => make (elements spend element (below 9n))
        end
      | #Record { fields, build, .. } =>
        match build
          (array::map
            (fn field => match field with
            | hide 'field { mirror, bind, .. } => bind (generate_at spend mirror)
            end)
            fields) with
        | #Some record => record
        | #Error _ => reflect::construct mirror
        end
      | #Sum { cases, .. } =>
        match choose cases with
        | #Some case =>
          match case with
          | hide 'payload { mirror, inject, .. } => inject (generate_at spend mirror)
          end
        | #None => reflect::construct mirror
        end
      end
    end

@doc "Generates a value using explicit construction evidence and a shared expansion budget. Each generated position spends one unit; exhausted positions use finite pure construction without drawing. Arrays and printable-ASCII strings have lengths 0 through 8. Integer kinds sample their exact domain, reals use Random.real, booleans use Random.boolean, and realizable sum cases are chosen uniformly. This is not uniform sampling over all values of a type. Rejection sampling retains nat_below's source-liveness assumptions; the budget bounds randomized expansion, not total output size."
let generate: Nat -> Mirror 'a -> 'a + !Random = fn budget mirror => do
  let remaining = mut budget
  return generate_at
    (fn _ =>
      if nat::is_zero (~remaining) then false
      else
        do
          _ = remaining := nat::subtract (~remaining) 1n
          return true
        end
      end)
    mirror
end

@doc "Generates a value of the inferred type with an expansion budget of 64. Requires constructive Mirror evidence and returns the value directly."
let random: () -> 'a + !Random = fn _ => generate 64n (reflect::mirror ())
