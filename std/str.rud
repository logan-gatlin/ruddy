@doc "Joins two strings."
extern concat: fn(String, String) -> String = "$prim.str.concat"
@doc "The number of Unicode scalar values in the text: `\"😀\"` has length one."
extern len: fn(String) -> Nat = "$prim.str.len"

@doc "How many bytes this text is as UTF-8. Scalars are what `len` counts; this is what a byte budget counts, and what crosses a binary boundary."
extern utf8_len: fn(String) -> Nat = "$prim.str.utf8_len"
@doc "Whether the string contains no scalar values."
let is_empty: String -> Bool = fn value => match value with | "" => true | _ => false end

@doc "The decimal text of a natural number."
extern from_nat: fn(Nat) -> String = "$prim.str.from_nat"
@doc "The decimal text of an integer."
extern from_int: fn(Int) -> String = "$prim.str.from_int"
@doc "The text representation of a real number."
extern from_real: fn(Real) -> String = "$prim.str.from_real"
@doc "`\"true\"` for `true` and `\"false\"` for `false`."
let from_boolean: Bool -> String = fn b => match b with | true => "true" | false => "false" end

@private
extern ordering_less_than: fn(String, String) -> Bool = "$prim.str.ordering_less_than"
@private
extern ordering_greater_than: fn(String, String) -> Bool = "$prim.str.ordering_greater_than"

@doc "Whether the string contains the substring."
extern contains: fn(String, String) -> Bool = "$prim.str.contains"
@doc "Whether the string begins with the prefix."
extern starts_with: fn(String, String) -> Bool = "$prim.str.starts_with"
@doc "Whether the string ends with the suffix."
extern ends_with: fn(String, String) -> Bool = "$prim.str.ends_with"
@doc "The scalar at a position, counting scalars from zero; empty past the end."
extern char_at: fn(String, Nat) -> String = "$prim.str.char_at"
@doc "The scalar position of the first occurrence of `search`, or -1."
extern index_of: fn(String, String) -> Int = "$prim.str.index_of"

@doc "The scalars from `start` up to `end`, counting scalars from zero."
extern slice: fn(String, Nat, Nat) -> String = "$prim.str.slice"
@doc "Removes whitespace from both ends."
extern trim: fn(String) -> String = "$prim.str.trim"
@doc "Removes whitespace from the beginning."
extern trim_start: fn(String) -> String = "$prim.str.trim_start"
@doc "Removes whitespace from the end."
extern trim_end: fn(String) -> String = "$prim.str.trim_end"
@doc "Converts cased scalars to lowercase."
extern to_lowercase: fn(String) -> String = "$prim.str.to_lowercase"
@doc "Converts cased scalars to uppercase."
extern to_uppercase: fn(String) -> String = "$prim.str.to_uppercase"

@doc "Repeats the string the supplied number of times."
extern repeat: fn(String, Nat) -> String = "$prim.str.repeat"
@doc "Replace the first occurrence of a plain substring. The replacement is inserted as written: `$&` and its relatives are text, not a substitution. An empty search matches before the first scalar."
extern replace_first: fn(String, String, String) -> String = "$prim.str.replace_first"
@doc "Replace every occurrence of a plain substring, left to right and without overlapping. The replacement is inserted as written. An empty search matches at every scalar boundary, including before the first scalar and after the last."
extern replace_all: fn(String, String, String) -> String = "$prim.str.replace_all"
@doc "Pads the beginning to the requested scalar length."
extern pad_start: fn(String, Nat, String) -> String = "$prim.str.pad_start"
@doc "Pads the end to the requested scalar length."
extern pad_end: fn(String, Nat, String) -> String = "$prim.str.pad_end"
@doc "The scalar values in reverse order."
extern reverse: fn(String) -> String = "$prim.str.reverse"

@doc "Compares two strings by scalar value."
let compare: order::Ordering String = fn left right =>
  if ordering_less_than left right then #Less
  else if ordering_greater_than left right then #Greater
  else #Equal
  end

@doc "The Boolean comparisons derived from the three-way ordering."
let {
  equal,
  not_equal,
  less_than,
  less_than_or_equal,
  greater_than,
  greater_than_or_equal,
} = order::derive compare

@doc "Whether the string is empty or contains only whitespace."
let is_blank: String -> Bool = fn value => is_empty (trim value)

@doc "The scalar at the zero-based position, or `#None` when the position is outside the string."
let char_at_option: String -> Nat -> Option String = fn value index =>
  if nat::less_than index (len value) then #Some (char_at value index) else #None end

@doc "The zero-based scalar position of the first occurrence, or `#None` when it is absent."
let index_of_option: String -> String -> Option Nat = fn value search => do
  let index = index_of value search
  return if int::less_than index 0i then #None else #Some (nat::from_int index) end
end

@doc "The first requested number of scalar values."
let take: String -> Nat -> String = fn value count => slice value 0n count
@doc "The text after the requested number of scalar values."
let drop: String -> Nat -> String = fn value count => slice value count (len value)

@doc "The text after a matching prefix."
let strip_prefix: String -> String -> Option String = fn value prefix =>
  if starts_with value prefix then #Some (drop value (len prefix)) else #None end

@doc "The text before a matching suffix."
let strip_suffix: String -> String -> Option String = fn value suffix =>
  if ends_with value suffix then #Some (take value (nat::subtract (len value) (len suffix)))
  else #None
  end

@doc "The text before and after the first separator, or `#None` when it is absent."
let split_once: String -> String -> Option (String, String) = fn value separator =>
  match index_of_option value separator with
  | #Some index => #Some (take value index, drop value (nat::add index (len separator)))
  | #None => #None
  end

@doc "The scalar values as one-scalar strings."
let chars: String -> [String] = fn value =>
  if is_empty value then [] else [char_at value 0n, ..chars (drop value 1n)] end

@doc "Splits at every occurrence of a separator."
let split: String -> String -> [String] = fn value separator =>
  if is_empty separator then chars value
  else
    match index_of_option value separator with
    | #Some index =>
      [take value index, ..split (drop value (nat::add index (len separator))) separator]
    | #None => [value]
    end
  end

@doc "Joins strings with a separator between adjacent values."
let join: String -> [String] -> String = fn separator values => match values with
| [] => ""
| [head] => head
| [head, ..tail] => concat head (concat separator (join separator tail))
end

@doc "The scalars from `start` up to `end`, or `#None` when the positions are invalid."
let slice_with: String -> { start when 'start: Nat, stop when 'stop: Nat } -> String =
  fn value bounds => match bounds with
  | {} => value
  | { start } => slice value start (len value)
  | { stop } => slice value 0n stop
  | { start, stop } => slice value start stop
  end

@private
extern display_quote: String -> String = "$prim.json.quote"

-- Labels outside the portable ASCII identifier subset remain readable quoted.
@private
let display_label: String -> String = fn name => do
  let letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
  let digits = "0123456789"
  let reserved = [
    "let",
    "extern",
    "do",
    "return",
    "type",
    "end",
    "with",
    "match",
    "hide",
    "if",
    "then",
    "else",
    "fn",
    "effect",
    "handle",
    "raise",
    "and",
    "or",
    "xor",
    "not",
    "mut",
    "module",
    "using",
    "true",
    "false",
    "_",
  ]
  return
    if not is_empty name
      and contains letters (char_at name 0n)
      and array::all (fn ch => contains (concat letters digits) ch) (chars name)
      and not array::any (equal name) reserved then
      name
    else display_quote name
    end
end

@private
type DisplayLayout = { multiline: Bool, indent: String }

@private
let display_child: DisplayLayout -> DisplayLayout = fn layout =>
  if layout.multiline then { multiline: true, indent: concat layout.indent "    " }
  else layout
  end

@private
let display_block: String -> String -> DisplayLayout -> [String] -> String =
  fn open close layout items => match items with
  | [] => concat open close
  | _ =>
    if layout.multiline then
      do
        let child = concat layout.indent "    "
        let lines = array::map (fn item => concat child (concat item ",\n")) items
        return join "" [open, "\n", join "" lines, layout.indent, close]
      end
    else if equal open "{" then join "" [open, " ", join ", " items, " ", close]
    else if equal open "(" and nat::equal (array::len items) 1n then
      join "" [open, join "" items, ",", close]
    else join "" [open, join ", " items, close]
    end
  end

@private
let display_field_name: reflect::SomeField 'a -> String = fn field => match field with
| hide 'f { name, .. } => name
end

-- Length followed by scalar order puts canonical numeric labels in numeric order without parsing
-- them into the target's bounded Nat type.
@private
let display_position_order: reflect::SomeField 'a -> reflect::SomeField 'a -> order::Order =
  fn left right => match nat::compare
    (len (display_field_name left))
    (len (display_field_name right)) with
  | #Equal => compare (display_field_name left) (display_field_name right)
  | #Less => #Less
  | #Greater => #Greater
  end

@private
let display_is_tuple: [reflect::SomeField 'a] -> Nat -> Bool = fn fields index => match fields with
| [] => true
| [field, ..tail] =>
  equal (display_field_name field) (from_nat index)
    and display_is_tuple tail (nat::add index 1n)
end

@private
let display_fields: [reflect::SomeField 'a] -> 'a -> DisplayLayout -> Bool -> [String] =
  fn fields value layout tuple => array::map
    (fn field => match field with
    | hide 'f { name, mirror, read, .. } => do
      let text = match read value with
      | #Some item => display_value mirror item layout
      | #None => "<absent>"
      end
      return if tuple then text else join "" [display_label name, ": ", text] end
    end
    end)
    fields

@private
let display_record: reflect::RecordView 'a -> 'a -> DisplayLayout -> String =
  fn view value layout =>
    match array::sort_by display_position_order view.fields with
    | positions =>
      if display_is_tuple positions 0n then
        display_block "(" ")" layout (display_fields positions value (display_child layout) true)
      else
        display_block
          "{"
          "}"
          layout
          (display_fields
            (array::sort_by (order::compare_by compare display_field_name) view.fields)
            value
            (display_child layout)
            false)
      end
    end

@private
let display_cases: [reflect::SomeCase 'a] -> 'a -> DisplayLayout -> String =
  fn cases value layout => match cases with
  | [] => "<unknown>"
  | [case, ..tail] =>
    match case with
    | hide 'p { name, mirror, project, .. } =>
      match project value with
      | #None => display_cases tail value layout
      | #Some payload => do
        let tag = concat "#" (display_label name)
        return match reflect::shape mirror with
        | #Record view =>
          if nat::equal (array::len view.fields) 0n then tag
          else join "" [tag, " ", display_value mirror payload layout]
          end
        | #Sum _ => join "" [tag, " (", display_value mirror payload layout, ")"]
        | _ => join "" [tag, " ", display_value mirror payload layout]
        end
      end
      end
    end
  end

@private
let display_value: Mirror 'a -> 'a -> DisplayLayout -> String = fn mirror value layout =>
  match reflect::shape mirror with
  | #Nat { read, .. } => concat (from_nat (read value)) "n"
  | #Int { read, .. } => concat (from_int (read value)) "i"
  | #Real { read, .. } => do
    let number = read value
    return
      if real::equal number 0 and real::less_than (real::divide 1 number) 0 then "-0"
      else from_real number
      end
  end
  | #String { read, .. } => display_quote (read value)
  | #Bool { read, .. } => from_boolean (read value)
  | #Nat8 { read, .. } => concat (nat::to_string8 (read value)) "n8"
  | #Nat16 { read, .. } => concat (nat::to_string16 (read value)) "n16"
  | #Nat32 { read, .. } => concat (nat::to_string32 (read value)) "n32"
  | #Nat64 { read, .. } => concat (nat::to_string64 (read value)) "n64"
  | #Int8 { read, .. } => concat (int::to_string8 (read value)) "i8"
  | #Int16 { read, .. } => concat (int::to_string16 (read value)) "i16"
  | #Int32 { read, .. } => concat (int::to_string32 (read value)) "i32"
  | #Int64 { read, .. } => concat (int::to_string64 (read value)) "i64"
  | #Array view =>
    match view with
    | hide 'e { element, read, .. } =>
      display_block
        "["
        "]"
        layout
        (array::map (fn item => display_value element item (display_child layout)) (read value))
    end
  | #Record view => display_record view value layout
  | #Sum view => display_cases view.cases value layout
  | #Function _ => "<function>"
  | #Hidden _ => "<hidden>"
  | #Mirror _ => "<mirror>"
  | #Foreign => "<foreign>"
  end

@doc "Pretty prints a value through reflection using Ruddy-like syntax. Nonempty arrays, tuples, and records use newlines, four-space indentation, and trailing commas; there is no final newline or truncation. Named fields use alphabetical Unicode scalar order, tuples use positional order, and unit prints as `()`. Strings are quoted and escaped; integer suffixes and negative real zero are preserved. Non-finite reals print as `NaN`, `Infinity`, or `-Infinity`. Functions, hidden packages, mirrors, and foreign values (including cells) print as `<function>`, `<hidden>`, `<mirror>`, and `<foreign>`."
let display: 'a -> String = fn value =>
  display_value (reflect::mirror ()) value { multiline: true, indent: "" }

@doc "Formats a value on one line using the same reflection, ordering, escaping, numeric suffixes, and opaque placeholders as `display`. Collections use comma-separated elements with spaces; only a singleton tuple keeps a trailing comma. There is no final newline or truncation."
let debug: 'a -> String = fn value =>
  display_value (reflect::mirror ()) value { multiline: false, indent: "" }
