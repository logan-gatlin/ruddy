@doc "A value of any type, packaged with the mirror of that type: opened by `downcast`, or by a `hide` pattern, which makes the mirror evidence for the value's type."
type Any = hide 'a => { mirror: Mirror 'a, value: 'a }

@doc "Package a value with the mirror of its type."
let upcast: 'a -> Any = fn value => { mirror: reflect::type_of value, value: value }

@doc "The value packaged, when its type is exactly the one asked for: the same structure, primitives, and effect contracts. Nothing is converted."
let downcast: Any -> Option 'a = fn any => match any with
| hide 'x { mirror, value } =>
  match reflect::same mirror (reflect::mirror ()) with
  | #Some { forward, backward } => #Some (forward value)
  | #None => #None
  end
end
