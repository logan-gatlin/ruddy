@doc "A value packaged with authenticated descriptive evidence of its type, including functions and opaque values. The historical `mirror` field is `TypeInfo`: opening it grants observation and exact casting, without constructor authority."
type Any = hide 'a => { mirror: TypeInfo 'a, value: 'a }

@doc "Package a value with descriptive evidence of its static type."
let upcast: 'a -> Any = fn value => { mirror: reflect::info_of value, value: value }

@doc "The value packaged, when its type is exactly the one asked for: the same structure, primitives, and effect contracts. Nothing is converted."
let downcast: Any -> Option 'a = fn any => match any with
| hide 'x { mirror, value } =>
  match reflect::same_info mirror (reflect::type_info ()) with
  | #Some { forward, backward } => #Some (forward value)
  | #None => #None
  end
end
