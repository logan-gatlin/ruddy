extern add: fn(Int, Int) -> Int = "$prim.int.add"
extern subtract: fn(Int, Int) -> Int = "$prim.int.subtract"
extern multiply: fn(Int, Int) -> Int = "$prim.int.multiply"
extern divide: fn(Int, Int) -> Int = "$prim.int.divide"
extern remainder: fn(Int, Int) -> Int = "$prim.int.remainder"
@doc "The negation. Integers have one zero: negating zero is zero."
extern negate: fn(Int) -> Int = "$prim.int.negate"
extern abs: fn(Int) -> Int = "$prim.int.abs"

@private
extern ordering_less_than: fn(Int, Int) -> Bool = "$prim.int.ordering_less_than"
@private
extern ordering_greater_than: fn(Int, Int) -> Bool = "$prim.int.ordering_greater_than"

extern min: fn(Int, Int) -> Int = "$prim.int.min"
extern max: fn(Int, Int) -> Int = "$prim.int.max"
extern clamp: fn(Int, Int, Int) -> Int = "$prim.int.clamp"
let is_zero: Int -> Bool = fn value => match value with | 0i => true | _ => false end

extern from_nat: fn(Nat) -> Int = "$prim.int.from_nat"
extern from_real: fn(Real) -> Int = "$prim.int.from_real"

let compare: order::Ordering Int = fn left right =>
  if ordering_less_than left right then #Less
  else if ordering_greater_than left right then #Greater
  else #Equal
  end
let {
  equal,
  not_equal,
  less_than,
  less_than_or_equal,
  greater_than,
  greater_than_or_equal,
} = order::derive compare

-- Int8: arithmetic wraps modulo 2^8; division truncates toward zero.
let min_value8: Int8 = -128i8
let max_value8: Int8 = 127i8
extern add8: fn(Int8, Int8) -> Int8 = "$prim.int.add8"
extern subtract8: fn(Int8, Int8) -> Int8 = "$prim.int.subtract8"
extern multiply8: fn(Int8, Int8) -> Int8 = "$prim.int.multiply8"
extern divide8: fn(Int8, Int8) -> Int8 = "$prim.int.divide8"
extern remainder8: fn(Int8, Int8) -> Int8 = "$prim.int.remainder8"
extern negate8: fn(Int8) -> Int8 = "$prim.int.negate8"
extern abs8: fn(Int8) -> Int8 = "$prim.int.abs8"
@private
extern ordering_less_than8: fn(Int8, Int8) -> Bool = "$prim.int.ordering_less_than8"
@private
extern ordering_greater_than8: fn(Int8, Int8) -> Bool = "$prim.int.ordering_greater_than8"
extern min8: fn(Int8, Int8) -> Int8 = "$prim.int.min8"
extern max8: fn(Int8, Int8) -> Int8 = "$prim.int.max8"
extern clamp8: fn(Int8, Int8, Int8) -> Int8 = "$prim.int.clamp8"
extern is_zero8: fn(Int8) -> Bool = "$prim.int.is_zero8"
extern from_nat8: fn(Nat) -> Int8 = "$prim.int.from_nat8"
extern from_int8: fn(Int) -> Int8 = "$prim.int.from_int8"
extern to_string8: fn(Int8) -> String = "$prim.int.to_string8"
extern to_int8: fn(Int8) -> Int = "$prim.int.to_int8"
let compare8: order::Ordering Int8 = fn left right =>
  if ordering_less_than8 left right then #Less
  else if ordering_greater_than8 left right then #Greater
  else #Equal
  end
let {
  equal: equal8,
  not_equal: not_equal8,
  less_than: less_than8,
  less_than_or_equal: less_than_or_equal8,
  greater_than: greater_than8,
  greater_than_or_equal: greater_than_or_equal8,
} = order::derive compare8

