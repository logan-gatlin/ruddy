extern add: fn(Int, Int) -> Int = "(left, right) => left + right"
extern subtract: fn(Int, Int) -> Int = "(left, right) => left - right"
extern multiply: fn(Int, Int) -> Int = "(left, right) => left * right"
extern divide: fn(Int, Int) -> Int = "(left, right) => Math.trunc(left / right)"
extern remainder: fn(Int, Int) -> Int = "(left, right) => left % right"
extern negate: fn(Int) -> Int = "value => -value"
extern abs: fn(Int) -> Int = "Math.abs"

@private
extern ordering_less_than: fn(Int, Int) -> Bool = "(left, right) => left < right"
@private
extern ordering_greater_than: fn(Int, Int) -> Bool = "(left, right) => left > right"

extern min: fn(Int, Int) -> Int = "Math.min"
extern max: fn(Int, Int) -> Int = "Math.max"
extern clamp: fn(Int, Int, Int) -> Int =
  "(value, minimum, maximum) => Math.min(Math.max(value, minimum), maximum)"
let is_zero: Int -> Bool = fn value => match value with | 0i => true | _ => false end

extern from_nat: fn(Nat) -> Int = "value => value"
extern from_real: fn(Real) -> Int = "Math.trunc"

let compare: order::Ordering Int = fn left right =>
  if ordering_less_than left right then #Less
  else if ordering_greater_than left right then #Greater
  else #Equal
  end
let {
  equal,
  not_equal,
  less_than,
  less_than_or_equal,
  greater_than,
  greater_than_or_equal,
} = order::derive compare

-- Int8: arithmetic wraps modulo 2^8; division truncates toward zero.
let min_value8: Int8 = -128i8
let max_value8: Int8 = 127i8
extern add8: fn(Int8, Int8) -> Int8 = "(left, right) => ((left + right) << 24 >> 24)"
extern subtract8: fn(Int8, Int8) -> Int8 = "(left, right) => ((left - right) << 24 >> 24)"
extern multiply8: fn(Int8, Int8) -> Int8 = "(left, right) => ((left * right) << 24 >> 24)"
extern divide8: fn(Int8, Int8) -> Int8 =
  "(left, right) => { if (right === 0) throw new RangeError(\"division by zero\"); return ((Math.trunc(left / right)) << 24 >> 24); }"
extern remainder8: fn(Int8, Int8) -> Int8 =
  "(left, right) => { if (right === 0) throw new RangeError(\"division by zero\"); return ((left % right) << 24 >> 24); }"
extern negate8: fn(Int8) -> Int8 = "value => ((-value) << 24 >> 24)"
extern abs8: fn(Int8) -> Int8 = "value => value < 0 ? ((-value) << 24 >> 24) : value"
@private
extern ordering_less_than8: fn(Int8, Int8) -> Bool = "(left, right) => left < right"
@private
extern ordering_greater_than8: fn(Int8, Int8) -> Bool = "(left, right) => left > right"
extern min8: fn(Int8, Int8) -> Int8 = "(left, right) => left < right ? left : right"
extern max8: fn(Int8, Int8) -> Int8 = "(left, right) => left > right ? left : right"
extern clamp8: fn(Int8, Int8, Int8) -> Int8 =
  "(value, minimum, maximum) => value < minimum ? minimum : value > maximum ? maximum : value"
extern is_zero8: fn(Int8) -> Bool = "value => value === 0"
extern from_nat8: fn(Nat) -> Int8 =
  "value => { if (!Number.isSafeInteger(value)) throw new RangeError(\"expected a safe integer\"); return ((value) << 24 >> 24); }"
extern from_int8: fn(Int) -> Int8 =
  "value => { if (!Number.isSafeInteger(value)) throw new RangeError(\"expected a safe integer\"); return ((value) << 24 >> 24); }"
extern to_string8: fn(Int8) -> String = "value => String(value)"
extern to_int8: fn(Int8) -> Int =
  "value => { const result = value; if (!Number.isSafeInteger(result)) throw new RangeError(\"integer out of range\"); return result; }"
let compare8: order::Ordering Int8 = fn left right =>
  if ordering_less_than8 left right then #Less
  else if ordering_greater_than8 left right then #Greater
  else #Equal
  end
let {
  equal: equal8,
  not_equal: not_equal8,
  less_than: less_than8,
  less_than_or_equal: less_than_or_equal8,
  greater_than: greater_than8,
  greater_than_or_equal: greater_than_or_equal8,
} = order::derive compare8

