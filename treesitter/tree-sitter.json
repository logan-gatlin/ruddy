{
  "$schema": "https://tree-sitter.github.io/tree-sitter.schema.json",
  "grammars": [
    {
      "name": "ruddy",
      "camelcase": "Ruddy",
      "scope": "source.ruddy",
      "path": ".",
      "file-types": [
        "rud"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ],
      "injection-regex": "^(ruddy|rud)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "ruddy grammar for tree-sitter",
    "authors": [
      {
        "name": "ruddy"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
